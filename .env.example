# Optional Alpaca integrations. The dashboard can collect these securely in
# its Alpaca activation dialog, so you do not need to edit this file.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Optional services
MASSIVE_API_KEY=
GEMINI_API_KEY=
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=my_stocks
MONGO_COLLECTION_NAME=my_stocks_screen

# Optional email alerts
ALERT_SENDER_EMAIL=
ALERT_SENDER_PASSWORD=
ALERT_SMTP_SERVER=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_RECIPIENTS=

# Server
HOST=127.0.0.1
PORT=8050
DASH_DEBUG=0
